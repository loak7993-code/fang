# JSON in pure Fang. Parse tree values are tagged by kind; list and dict

# variants carry the collection through a ptr, read back with as_list and

# as_dict.

struct JValue:
  kind: str
  s: str
  i: int
  f: float
  b: bool
  ref: ptr

fn skip_ws(text: str, pos: int) -> int:
  while pos < len(text):
    let c = text[pos]
    if c != " " and c != "\n" and c != "\t" and c != "\r":
      break
    pos = pos + 1
  return pos

fn parse_str_body(text: str, pos: int) -> (str, int):
  # pos is just past the opening quote
  let out = ""
  while pos < len(text):
    let c = text[pos]
    if c == "\"":
      return (out, pos + 1)
    if c == "\\":
      pos = pos + 1
      if pos >= len(text):
        raise "json: unterminated escape"
      let e = text[pos]
      if e == "n":
        out = out + "\n"
      elif e == "t":
        out = out + "\t"
      elif e == "r":
        out = out + "\r"
      elif e == "\"":
        out = out + "\""
      elif e == "\\":
        out = out + "\\"
      elif e == "/":
        out = out + "/"
      else:
        raise "json: unsupported escape"
      pos = pos + 1
    else:
      out = out + c
      pos = pos + 1
  raise "json: unterminated string"

fn parse_number(text: str, pos: int) -> (JValue, int):
  let start = pos
  let is_float = false
  if pos < len(text) and text[pos] == "-":
    pos = pos + 1
  while pos < len(text):
    let c = text[pos]
    if c >= "0" and c <= "9":
      pos = pos + 1
    elif c == ".":
      is_float = true
      pos = pos + 1
    else:
      break
  let raw = text[start:pos]
  if is_float:
    let v = JValue("float", "", 0, raw.to_float(), false, nil)
    return (v, pos)
  let v = JValue("int", "", raw.to_int(), 0.0, false, nil)
  return (v, pos)

fn parse_list(text: str, pos: int) -> (JValue, int):
  # pos is just past '['
  let items: list[JValue] = []
  pos = skip_ws(text, pos)
  if pos < len(text) and text[pos] == "]":
    let v = JValue("list", "", 0, 0.0, false, cast[ptr](items))
    return (v, pos + 1)
  while true:
    pos = skip_ws(text, pos)
    let item, next = parse_value(text, pos)
    pos = next
    items.push(item)
    pos = skip_ws(text, pos)
    if pos >= len(text):
      raise "json: unterminated list"
    let c = text[pos]
    if c == "]":
      let v = JValue("list", "", 0, 0.0, false, cast[ptr](items))
      return (v, pos + 1)
    if c != ",":
      raise "json: expected , or ] in list"
    pos = pos + 1
  raise "json: unreachable"

fn parse_dict(text: str, pos: int) -> (JValue, int):
  # pos is just past '{'
  let entries: dict[str, JValue] = {}
  pos = skip_ws(text, pos)
  if pos < len(text) and text[pos] == "}":
    let v = JValue("dict", "", 0, 0.0, false, cast[ptr](entries))
    return (v, pos + 1)
  while true:
    pos = skip_ws(text, pos)
    if pos >= len(text) or text[pos] != "\"":
      raise "json: expected a key string in dict"
    let key, kpos = parse_str_body(text, pos + 1)
    pos = kpos
    pos = skip_ws(text, pos)
    if pos >= len(text) or text[pos] != ":":
      raise "json: expected : after key"
    pos = skip_ws(text, pos + 1)
    let val, next = parse_value(text, pos)
    pos = next
    entries.set(key, val)
    pos = skip_ws(text, pos)
    if pos >= len(text):
      raise "json: unterminated dict"
    let c = text[pos]
    if c == "}":
      let v = JValue("dict", "", 0, 0.0, false, cast[ptr](entries))
      return (v, pos + 1)
    if c != ",":
      raise "json: expected , or } in dict"
    pos = pos + 1
  raise "json: unreachable"

fn parse_value(text: str, pos: int) -> (JValue, int):
  pos = skip_ws(text, pos)
  if pos >= len(text):
    raise "json: unexpected end of input"
  let c = text[pos]
  if c == "{":
    return parse_dict(text, pos + 1)
  if c == "[":
    return parse_list(text, pos + 1)
  if c == "\"":
    let s, pos = parse_str_body(text, pos + 1)
    let v = JValue("str", s, 0, 0.0, false, nil)
    return (v, pos)
  if c == "t":
    if text[pos:pos + 4] == "true":
      let v = JValue("bool", "", 0, 0.0, true, nil)
      return (v, pos + 4)
    raise "json: bad literal"
  if c == "f":
    if text[pos:pos + 5] == "false":
      let v = JValue("bool", "", 0, 0.0, false, nil)
      return (v, pos + 5)
    raise "json: bad literal"
  if c == "n":
    if text[pos:pos + 4] == "null":
      let v = JValue("nil", "", 0, 0.0, false, nil)
      return (v, pos + 4)
    raise "json: bad literal"
  return parse_number(text, pos)

export fn parse(text: str) -> JValue:
  let v, next = parse_value(text, 0)
  return v

export fn as_list(v: JValue) -> list[JValue]:
  if v.kind != "list":
    raise "json: value is not a list"
  return cast[list[JValue]](v.ref)

export fn as_dict(v: JValue) -> dict[str, JValue]:
  if v.kind != "dict":
    raise "json: value is not a dict"
  return cast[dict[str, JValue]](v.ref)

export fn get(v: JValue, key: str) -> JValue:
  let d = as_dict(v)
  return d.get(key, JValue("nil", "", 0, 0.0, false, nil))

export fn at(v: JValue, index: int) -> JValue:
  let xs = as_list(v)
  return xs[index]

export fn stringify(v: JValue) -> str:
  if v.kind == "nil":
    return "null"
  if v.kind == "bool":
    if v.b:
      return "true"
    return "false"
  if v.kind == "int":
    return v.i.to_str()
  if v.kind == "float":
    return v.f.to_str()
  if v.kind == "str":
    return "\"" + v.s.replace("\"", "\\\"") + "\""
  if v.kind == "list":
    let xs = as_list(v)
    let out = "["
    let n = len(xs)
    for i in 0..n:
      if i > 0:
        out = out + ", "
      out = out + stringify(xs[i])
    return out + "]"
  if v.kind == "dict":
    let d = as_dict(v)
    let out = "{"
    let first = true
    for k, item in d.items():
      if not first:
        out = out + ", "
      first = false
      out = out + "\"" + k.replace("\"", "\\\"") + "\": " + stringify(item)
    return out + "}"
  raise "json: unknown kind"
