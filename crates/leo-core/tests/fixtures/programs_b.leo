fn main():
  d = {"one": 1, "two": 2}
  for k, v in d.items():
    try:
      if v == 2:
        raise "two is not allowed"
    except e:
      print(f"caught: {e}")
  let xs = [
    10,
    20,
    30,
  ]
  while len(xs) > 0:
    xs.pop()
  i = 0
  while i < 10:
    i = i + 1
    if i % 2 == 0:
      continue
    elif i == 9:
      break
    else:
      pass
