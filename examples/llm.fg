# Fang LLM: a GGUF inference engine, in Fang.

# fang run llm.fg -- model.gguf "prompt" [--n 128] [--temp 0.8]

# qwen2 architecture, Q5_0 / Q8_0 / Q4_K / Q6_K / F32 tensors.

import fs
import str
import os
import math
import time

extern fn fang_llm_matvec(t: int, blob: str, off: int, rows: int, x: list[float], out: list[float], n: int, bias_off: int, threads: int) from "fang_rt.h"

extern fn fang_llm_matvec0(t: int, blob: str, off: int, rows: int, x: list[float], out: list[float], n: int, threads: int) from "fang_rt.h"

extern fn fang_llm_matvec2(t1: int, t2: int, blob: str, o1: int, r1: int, o2: int, r2: int, x: list[float], out1: list[float], out2: list[float], n: int, threads: int) from "fang_rt.h"

extern fn fang_llm_matvec3(t1: int, t2: int, t3: int, blob: str, o1: int, r1: int, b1: int, o2: int, r2: int, b2: int, o3: int, r3: int, b3: int, x: list[float], out1: list[float], out2: list[float], out3: list[float], n: int, threads: int) from "fang_rt.h"

extern fn fang_llm_rms_norm(x: list[float], w: list[float], out: list[float], n: int, eps: float) from "fang_rt.h"

extern fn fang_llm_rope(x: list[float], pos: int, heads: int, head_dim: int, freq_base: float) from "fang_rt.h"

extern fn fang_llm_kv_append(kcache: list[float], vcache: list[float], k: list[float], v: list[float], pos: int, kv_dim: int) from "fang_rt.h"

extern fn fang_llm_attention(q: list[float], kcache: list[float], vcache: list[float], pos: int, n_heads: int, n_kv_heads: int, head_dim: int, out: list[float], threads: int) from "fang_rt.h"

extern fn fang_llm_layer(blob: str, hidden: int, kv_dim: int, ffn: int, pos: int, n_heads: int, n_kv_heads: int, head_dim: int, freq_base: float, eps: float, threads: int, norm1: int, norm2: int, tq: int, wq: int, bq: int, tk: int, wk: int, bk: int, tv: int, wv: int, bv: int, to: int, wo: int, tg: int, wg: int, tu: int, wu: int, td: int, wd: int, h: list[float], xn: list[float], q: list[float], k: list[float], v: list[float], kcache: list[float], vcache: list[float], attn_out: list[float], gate: list[float], up: list[float], act: list[float], xn2: list[float]) from "fang_rt.h"

extern fn fang_pool_seq_end() from "fang_rt.h"

extern fn fang_llm_silu_mul(gate: list[float], up: list[float], out: list[float], n: int) from "fang_rt.h"

extern fn fang_llm_add(a: list[float], b: list[float], out: list[float], n: int) from "fang_rt.h"

extern fn fang_llm_argmax(logits: list[float], n: int) -> int from "fang_rt.h"

let threads = 8

extern fn fang_print_raw(s: str) from "fang_rt.h"

extern fn fang_utf8_from_bytes(bytes: list[int]) -> str from "fang_rt.h"

fn byte_at(s: str, i: int) -> int:
  str.byte_at(s, i)

fn u16_at(s: str, i: int) -> int:
  byte_at(s, i) | byte_at(s, i + 1) << 8

fn u32_at(s: str, i: int) -> int:
  u16_at(s, i) | u16_at(s, i + 2) << 16

fn u64_at(s: str, i: int) -> int:
  u32_at(s, i) | u32_at(s, i + 4) << 32

fn f32_at(s: str, i: int) -> float:
  bits = u32_at(s, i)
  sign = 1.0
  if bits >= 2147483648:
    sign = -1.0
    bits = bits - 2147483648
  exp = bits >> 23 & 255
  man = bits & 8388607
  if exp == 0:
    if man == 0:
      return sign * 0.0
    return sign * man * 0.000000000000000000000000000000000000000000001401298464324817
  if exp == 255:
    return sign * (1.0 / 0.0)
  sign * (man + 8388608) * math.pow(2.0, (exp - 127 - 23) * 1.0)
  # ---- model ----

struct Model:
  blob: str
  data_off: int
  n_layers: int
  hidden: int
  n_heads: int
  n_kv_heads: int
  head_dim: int
  ffn: int
  vocab: int
  rope_base: float
  rms_eps: float
  eos: int
  vocab_str: list[str]
  vocab_id: dict[str, int]
  merges: dict[str, int]
  tensor_off: dict[str, int]
  tensor_type: dict[str, int]
  tensor_row: dict[str, int]

fn fp16_at(s: str, i: int) -> float:
  h = u16_at(s, i)
  sign = 1.0
  if h >= 32768:
    sign = -1.0
    h = h - 32768
  exp = h >> 10 & 31
  man = h & 1023
  if exp == 0:
    if man == 0:
      return sign * 0.0
    return sign * man * 0.00000005960464477539063
  if exp == 31:
    return sign * (1.0 / 0.0)
  sign * (man + 1024) * math.pow(2.0, (exp - 25) * 1.0)

let T_U8 = 0

let T_I8 = 1

let T_U16 = 2

let T_I16 = 3

let T_U32 = 4

let T_I32 = 5

let T_F32 = 6

let T_BOOL = 7

let T_STR = 8

let T_ARR = 9

let T_U64 = 10

let T_I64 = 11

let T_F64 = 12

fn fixed_size(t: int) -> int:
  if t == T_U8 or t == T_I8 or t == T_BOOL:
    return 1
  if t == T_U16 or t == T_I16:
    return 2
  if t == T_U32 or t == T_I32 or t == T_F32:
    return 4
  8

fn skip_value(b: str, i: int, t: int) -> int:
  if t == T_STR:
    n = u64_at(b, i)
    return i + 8 + n
  if t == T_ARR:
    et = u32_at(b, i)
    n = u64_at(b, i + 4)
    j = i + 12
    for k in 0..n:
      j = skip_value(b, j, et)
    return j
  return i + fixed_size(t)

fn load_model(path: str) -> Model:
  b = fs.read_file(path)
  vocab_str: list[str] = []
  vocab_id: dict[str, int] = {}
  merges: dict[str, int] = {}
  tensor_off: dict[str, int] = {}
  tensor_type: dict[str, int] = {}
  tensor_row: dict[str, int] = {}
  m = Model(b, 0, 24, 896, 14, 2, 64, 4864, 151936, 1000000.0, 0.000001, 151645, vocab_str, vocab_id, merges, tensor_off, tensor_type, tensor_row)
  if b.slice(0, 4) != "GGUF":
    print("not a GGUF file")
    os.exit(1)
  n_tensors = u64_at(b, 8)
  n_kv = u64_at(b, 16)
  i = 24
  for kv in 0..n_kv:
    klen = u64_at(b, i)
    key = b.slice(i + 8, i + 8 + klen)
    i = i + 8 + klen
    t = u32_at(b, i)
    i = i + 4
    if t == T_U64 or t == T_I64 or t == T_F64:
      val = u64_at(b, i)
      i = i + 8
      if key == "qwen2.block_count":
        m.n_layers = val
      elif key == "qwen2.embedding_length":
        m.hidden = val
      elif key == "qwen2.attention.head_count":
        m.n_heads = val
      elif key == "qwen2.attention.head_count_kv":
        m.n_kv_heads = val
      elif key == "tokenizer.ggml.eos_token_id":
        m.eos = val
    elif t == T_U32 or t == T_I32:
      val = u32_at(b, i)
      i = i + 4
      if key == "tokenizer.ggml.eos_token_id":
        m.eos = val
    elif t == T_F32:
      if key == "qwen2.rope.freq_base":
        m.rope_base = f32_at(b, i)
      if key == "qwen2.attention.layer_norm_rms_epsilon":
        m.rms_eps = f32_at(b, i)
      i = i + 4
    elif t == T_STR:
      n = u64_at(b, i)
      i = i + 8 + n
    elif t == T_ARR:
      et = u32_at(b, i)
      n = u64_at(b, i + 4)
      i = i + 12
      if key == "tokenizer.ggml.tokens":
        for k in 0..n:
          sl = u64_at(b, i)
          piece = b.slice(i + 8, i + 8 + sl)
          m.vocab_str.push(piece)
          i = i + 8 + sl
      elif key == "tokenizer.ggml.merges":
        for k in 0..n:
          sl = u64_at(b, i)
          # ranks stored +1 so rank 0 never collides with "missing" (0)
          m.merges[b.slice(i + 8, i + 8 + sl)] = k + 1
          i = i + 8 + sl
      else:
        for k in 0..n:
          i = skip_value(b, i, et)
    else:
      i = i + fixed_size(t)
      # tensor table
  raw_off: dict[str, int] = {}
  for t_i in 0..n_tensors:
    nlen = u64_at(b, i)
    name = b.slice(i + 8, i + 8 + nlen)
    i = i + 8 + nlen
    nd = u32_at(b, i)
    i = i + 4
    ne0 = u64_at(b, i)
    i = i + 8 * nd
    tt = u32_at(b, i)
    i = i + 4
    toff = u64_at(b, i)
    i = i + 8
    raw_off[name] = toff
    m.tensor_type[name] = tt
    m.tensor_row[name] = ne0
  m.data_off = (i + 31) / 32 * 32
  for name in raw_off.keys():
    m.tensor_off[name] = m.data_off + raw_off[name]
  m.head_dim = m.hidden / m.n_heads
  for k in 0..len(m.vocab_str):
    m.vocab_id[m.vocab_str[k]] = k
  m
  # ---- tokenizer ----

let char_table: list[str] = []

fn init_char_cache():
  for cp in 0..70000:
    char_table.push(cp_str(cp))

fn cp_str(cp: int) -> str:
  if cp < 128:
    return utf8_of([cp])
  if cp < 2048:
    return utf8_of([192 | cp >> 6, 128 | cp & 63])
  if cp < 65536:
    return utf8_of([224 | cp >> 12, 128 | cp >> 6 & 63, 128 | cp & 63])
  utf8_of([240 | cp >> 18, 128 | cp >> 12 & 63, 128 | cp >> 6 & 63, 128 | cp & 63])

fn utf8_of(bytes: list[int]) -> str:
  fang_utf8_from_bytes(bytes)

fn b2u(b: int) -> str:
  if b >= 33 and b <= 126:
    return char_table[b]
  if b >= 161 and b <= 172:
    return char_table[b]
  if b >= 174 and b <= 255:
    return char_table[b]
  char_table[256 + b]

fn bpe_word(m: Model, word: str) -> list[int]:
  # Words arriving here contain ASCII plus b2u-mapped chars; every
  # mapped char is a 2-byte UTF-8 sequence, so syms split on that.
  syms: list[str] = []
  i = 0
  while i < len(word):
    n = 1
    if byte_at(word, i) >= 192 and i + 1 < len(word):
      n = 2
    syms.push(word.slice(i, i + n))
    i = i + n
  while true:
    best_rank = -1
    best_i = 0
    for i in 0..len(syms) - 1:
      r = m.merges[syms[i] + " " + syms[i + 1]]
      if r > 0 and (best_rank < 0 or r < best_rank):
        best_rank = r
        best_i = i
    if best_rank < 0:
      break
    new_syms: list[str] = []
    for i in 0..len(syms):
      if i == best_i:
        new_syms.push(syms[i] + syms[i + 1])
      elif i == best_i + 1:
        pass
      else:
        new_syms.push(syms[i])
    syms = new_syms
  ids: list[int] = []
  for s in syms:
    ids.push(m.vocab_id[s])
  ids

fn bpe_encode(m: Model, text: str) -> list[int]:
  # <|im_start|> and <|im_end|> are single vocab entries BPE can never
  # build from bytes. Split on them and emit ids in prompt order:
  # each text piece is tokenized and pushed before the next special id.
  ids: list[int] = []
  rest = text
  while true:
    a = str.find_from(rest, 0, "<|im_start|>")
    b = str.find_from(rest, 0, "<|im_end|>")
    cut = -1
    which = 0
    tlen = 0
    if a >= 0 and (b < 0 or a < b):
      cut = a
      which = 151644
      tlen = 12
    elif b >= 0:
      cut = b
      which = 151645
      tlen = 10
    if cut < 0:
      for t in bpe_text(m, rest):
        ids.push(t)
      break
    for t in bpe_text(m, rest.slice(0, cut)):
      ids.push(t)
    ids.push(which)
    rest = rest.slice(cut + tlen, len(rest))
  ids

fn bpe_text(m: Model, text: str) -> list[int]:
  # Qwen2 pretokenizer (byte-level): contractions, letters with one
  # optional leading non-letter, single digits, space-attached punct
  # runs, newline runs, trailing-whitespace rules.
  ids: list[int] = []
  i = 0
  n = len(text)
  while i < n:
    pl = next_piece(text, i, n)
    word = text.slice(i, i + pl)
    cur = ""
    for b in 0..len(word):
      cur = cur + b2u(byte_at(word, b))
    for t in bpe_word(m, cur):
      ids.push(t)
    i = i + pl
  ids

fn is_wsb(b: int) -> bool:
  b == 32 or b == 9 or b == 10 or b == 13

fn is_letter(b: int) -> bool:
  # ASCII letters; other bytes are treated as letters too (CJK and
  # most accented text is \p{L}; emoji will piece as letters, which
  # only affects merge granularity, not correctness of the split).
  (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b >= 128

fn is_digitb(b: int) -> bool:
  b >= 48 and b <= 57

fn contraction_len(text: str, i: int, n: int) -> int:
  # 's 't 'm 'd are 2 bytes, 're 've 'll are 3, case-insensitive.
  if i + 1 >= n:
    return 0
  c1 = byte_at(text, i + 1) | 32
  if c1 == 115 or c1 == 116 or c1 == 109 or c1 == 100:
    return 2
  if i + 2 < n:
    c2 = byte_at(text, i + 2) | 32
    if c1 == 114 and c2 == 101:
      return 3
    if c1 == 118 and c2 == 101:
      return 3
    if c1 == 108 and c2 == 108:
      return 3
  return 0

fn next_piece(text: str, i: int, n: int) -> int:
  c = byte_at(text, i)
  if c == 39:
    cl = contraction_len(text, i, n)
    if cl > 0:
      return cl
  # letters, with one optional leading char that is not \r\n, letter
  # or digit (space, tab and punctuation all qualify)
  j = i
  if not is_letter(c) and not is_digitb(c) and c != 10 and c != 13 and i + 1 < n:
    j = i + 1
  if j < n and is_letter(byte_at(text, j)):
    k = j + 1
    while k < n and is_letter(byte_at(text, k)):
      k = k + 1
    return k - i
  # exactly one digit per piece
  if is_digitb(c):
    return 1
  # space-attached punctuation run, then any trailing \r\n
  j = i
  if c == 32 and i + 1 < n:
    j = i + 1
  if j < n and not is_wsb(byte_at(text, j)) and not is_letter(byte_at(text, j)) and not is_digitb(byte_at(text, j)):
    k = j + 1
    while k < n and not is_wsb(byte_at(text, k)) and not is_letter(byte_at(text, k)) and not is_digitb(byte_at(text, k)):
      k = k + 1
    while k < n and (byte_at(text, k) == 10 or byte_at(text, k) == 13):
      k = k + 1
    return k - i
  # whitespace: run containing \r\n ends after the newline run;
  # otherwise \s+(?!\S) keeps all but the last char when a
  # non-space follows, and a lone whitespace stands alone
  if is_wsb(c):
    k = i
    while k < n and is_wsb(byte_at(text, k)):
      k = k + 1
    last = -1
    for w in i..k:
      if byte_at(text, w) == 10 or byte_at(text, w) == 13:
        last = w
    if last >= 0:
      q = last + 1
      while q < k and (byte_at(text, q) == 10 or byte_at(text, q) == 13):
        q = q + 1
      return q - i
    if k < n and k - i >= 2:
      return k - 1 - i
    return k - i
  return 1

fn unmap(text: str) -> str:
  out: list[int] = []
  i = 0
  while i < len(text):
    c = byte_at(text, i)
    if c < 128:
      out.push(c)
      i = i + 1
    elif c == 196 or c == 197:
      # U+0100..U+017F: mapped byte = codepoint - 256
      cp = (c & 31) << 6 | byte_at(text, i + 1) & 63
      out.push(cp - 256)
      i = i + 2
    else:
      out.push(c)
      i = i + 1
  utf8_of(out)
  # ---- forward pass ----

struct Cache:
  k: list[list[float]]
  v: list[list[float]]

fn make_cache(m: Model, ctx: int) -> Cache:
  k_layers: list[list[float]] = []
  v_layers: list[list[float]] = []
  for layer in 0..m.n_layers:
    kbuf: list[float] = []
    vbuf: list[float] = []
    for i in 0..ctx * m.n_kv_heads * m.head_dim:
      kbuf.push(0.0)
      vbuf.push(0.0)
    k_layers.push(kbuf)
    v_layers.push(vbuf)
  Cache(k_layers, v_layers)

fn row_bytes(t: int, n: int) -> int:
  if t == 6:
    return n / 32 * 22
  elif t == 8:
    return n / 32 * 34
  elif t == 12:
    return n / 256 * 144
  elif t == 14:
    return n / 256 * 210
  return n * 4

fn load_f32_row_into(m: Model, name: str, row: int, out: list[float]):
  # reuse semantics: callers may pass a persistent buffer
  while len(out) > 0:
    out.pop()
  t = m.tensor_type[name]
  off = m.tensor_off[name] + row * row_bytes(t, m.tensor_row[name])
  n = m.tensor_row[name]
  if t == 0:
    for i in 0..n:
      out.push(f32_at(m.blob, off + i * 4))
  elif t == 6:
    # Q5_0: 22-byte blocks of 32
    for blk in 0..n / 32:
      bo = off + blk * 22
      d = fp16_at(m.blob, bo)
      qh = u32_at(m.blob, bo + 2)
      for j in 0..16:
        xh0 = qh >> j << 4 & 16
        xh1 = qh >> (j + 12) & 16
        qs = byte_at(m.blob, bo + 6 + j)
        out.push(((qs & 15 | xh0) - 16) * d)
      for j in 0..16:
        xh1 = qh >> (j + 12) & 16
        qs = byte_at(m.blob, bo + 6 + j)
        out.push(((qs >> 4 | xh1) - 16) * d)
  elif t == 8:
    # Q8_0: 34-byte blocks of 32
    for blk in 0..n / 32:
      bo = off + blk * 34
      d = fp16_at(m.blob, bo)
      for j in 0..32:
        q = byte_at(m.blob, bo + 2 + j)
        if q >= 128:
          q = q - 256
        out.push(q * d)
  else:
    print("load_row: unsupported type", t, "for", name)
    os.exit(1)

fn load_f32_row(m: Model, name: str, row: int) -> list[float]:
  out: list[float] = []
  load_f32_row_into(m, name, row, out)
  out

struct Weights:
  final_norm: list[float]

struct Bufs:
  h: list[float]
  xn: list[float]
  xn2: list[float]
  q: list[float]
  k: list[float]
  v: list[float]
  attn_out: list[float]
  gate: list[float]
  up: list[float]
  act: list[float]
  final: list[float]
  logits: list[float]

fn zeros(n: int) -> list[float]:
  out: list[float] = []
  for i in 0..n:
    out.push(0.0)
  out

fn load_weights(m: Model) -> Weights:
  Weights(load_f32_row(m, "output_norm.weight", 0))

fn make_bufs(m: Model) -> Bufs:
  kv_dim = m.n_kv_heads * m.head_dim
  Bufs(zeros(m.hidden), zeros(m.hidden), zeros(m.hidden), zeros(m.hidden), zeros(kv_dim), zeros(kv_dim), zeros(m.hidden), zeros(m.ffn), zeros(m.ffn), zeros(m.ffn), zeros(m.hidden), zeros(m.vocab))

# Per-layer tensor offsets and types, resolved once so the token loop
# never touches the string-keyed tensor dicts again.
struct Plan:
  n1: list[int]
  n2: list[int]
  tq: list[int]
  tk: list[int]
  tv: list[int]
  wq: list[int]
  wk: list[int]
  wv: list[int]
  bq: list[int]
  bk: list[int]
  bv: list[int]
  wo: list[int]
  to: list[int]
  tg: list[int]
  tu: list[int]
  wg: list[int]
  wu: list[int]
  wd: list[int]
  td: list[int]
  wout: int
  tout: int
  bout: int

fn build_plan(m: Model) -> Plan:
  n1: list[int] = []
  n2: list[int] = []
  tq: list[int] = []
  tk: list[int] = []
  tv: list[int] = []
  wq: list[int] = []
  wk: list[int] = []
  wv: list[int] = []
  bq: list[int] = []
  bk: list[int] = []
  bv: list[int] = []
  wo: list[int] = []
  to: list[int] = []
  tg: list[int] = []
  tu: list[int] = []
  wg: list[int] = []
  wu: list[int] = []
  wd: list[int] = []
  td: list[int] = []
  for layer in 0..m.n_layers:
    pre = "blk." + str(layer) + "."
    n1.push(m.tensor_off[pre + "attn_norm.weight"])
    n2.push(m.tensor_off[pre + "ffn_norm.weight"])
    tq.push(m.tensor_type[pre + "attn_q.weight"])
    tk.push(m.tensor_type[pre + "attn_k.weight"])
    tv.push(m.tensor_type[pre + "attn_v.weight"])
    wq.push(m.tensor_off[pre + "attn_q.weight"])
    wk.push(m.tensor_off[pre + "attn_k.weight"])
    wv.push(m.tensor_off[pre + "attn_v.weight"])
    bq.push(m.tensor_off[pre + "attn_q.bias"])
    bk.push(m.tensor_off[pre + "attn_k.bias"])
    bv.push(m.tensor_off[pre + "attn_v.bias"])
    wo.push(m.tensor_off[pre + "attn_output.weight"])
    to.push(m.tensor_type[pre + "attn_output.weight"])
    tg.push(m.tensor_type[pre + "ffn_gate.weight"])
    tu.push(m.tensor_type[pre + "ffn_up.weight"])
    wg.push(m.tensor_off[pre + "ffn_gate.weight"])
    wu.push(m.tensor_off[pre + "ffn_up.weight"])
    wd.push(m.tensor_off[pre + "ffn_down.weight"])
    td.push(m.tensor_type[pre + "ffn_down.weight"])
  # the lm_head has no bias tensor in qwen2 GGUFs; a dict miss would
  # resolve to offset 0 (the file header), so pass -1 = no bias
  Plan(n1, n2, tq, tk, tv, wq, wk, wv, bq, bk, bv, wo, to, tg, tu, wg, wu, wd, td, m.tensor_off["output.weight"], m.tensor_type["output.weight"], -1)

# One forward pass: embedding dequant, then per layer rms_norm, fused
# qkv matvec, rope, KV append, attention, output projection, SwiGLU,
# down projection. Every kernel runs in C; buffers are preallocated.
fn forward(m: Model, cache: Cache, w: Weights, b: Bufs, pl: Plan, token: int, pos: int) -> int:
  kv_dim = m.n_kv_heads * m.head_dim
  load_f32_row_into(m, "token_embd.weight", token, b.h)
  for layer in 0..m.n_layers:
    fang_llm_layer(m.blob, m.hidden, kv_dim, m.ffn, pos, m.n_heads, m.n_kv_heads, m.head_dim, m.rope_base, m.rms_eps, threads, pl.n1[layer], pl.n2[layer], pl.tq[layer], pl.wq[layer], pl.bq[layer], pl.tk[layer], pl.wk[layer], pl.bk[layer], pl.tv[layer], pl.wv[layer], pl.bv[layer], pl.to[layer], pl.wo[layer], pl.tg[layer], pl.wg[layer], pl.tu[layer], pl.wu[layer], pl.td[layer], pl.wd[layer], b.h, b.xn, b.q, b.k, b.v, cache.k[layer], cache.v[layer], b.attn_out, b.gate, b.up, b.act, b.xn2)
  fang_llm_rms_norm(b.h, w.final_norm, b.xn, m.hidden, m.rms_eps)
  fang_llm_matvec(pl.tout, m.blob, pl.wout, m.vocab, b.xn, b.logits, m.hidden, pl.bout, threads)
  fang_pool_seq_end()
  fang_llm_argmax(b.logits, m.vocab)
  # ---- sampling ----

fn sample_greedy(logits: list[float]) -> int:
  fang_llm_argmax(logits, len(logits))

fn sample_temp(logits: list[float], temp: float) -> int:
  mx = logits[0]
  for i in 1..len(logits):
    if logits[i] > mx:
      mx = logits[i]
  top: list[int] = []
  used: list[int] = []
  for k in 0..40:
    best = -1
    bv = -1000000000000000019884624838656.0
    for i in 0..len(logits):
      seen = false
      for j in used:
        if j == i:
          seen = true
      if not seen and logits[i] > bv:
        bv = logits[i]
        best = i
    if best >= 0:
      top.push(best)
      used.push(best)
  total = 0.0
  probs: list[float] = []
  for k in 0..len(top):
    p = math.exp((logits[top[k]] - mx) / temp)
    probs.push(p)
    total = total + p
  r = math.random() * total
  acc = 0.0
  for k in 0..len(top):
    acc = acc + probs[k]
    if r <= acc:
      return top[k]
  top[len(top) - 1]
  # ---- main ----

fn main():
  args = os.args()
  model_path = ""
  prompt = "hello"
  n_gen = 48
  temp = 0.0
  i = 1
  while i < len(args):
    if args[i] == "--n":
      n_gen = str.to_int(args[i + 1])
      i = i + 2
    elif args[i] == "--temp":
      temp = str.to_float(args[i + 1])
      i = i + 2
    elif model_path == "":
      model_path = args[i]
      i = i + 1
    elif prompt == "hello":
      prompt = args[i]
      i = i + 1
    else:
      i = i + 1
  if model_path == "":
    print("usage: fang run llm.fg -- model.gguf \"prompt\" [--n 128] [--temp 0.8]")
    os.exit(1)
  t_load = time.now()
  m = load_model(model_path)
  print("loaded", model_path, "in", time.now() - t_load, "s: layers", m.n_layers, "hidden", m.hidden, "vocab", m.vocab)
  cache = make_cache(m, 2048)
  init_char_cache()
  chat = "<|im_start|>user\n" + prompt + "<|im_end|>\n<|im_start|>assistant\n"
  ids = bpe_encode(m, chat)
  print("prompt:", len(ids), "tokens")
  w = load_weights(m)
  bufs = make_bufs(m)
  pl = build_plan(m)
  t0 = time.now()
  pos = 0
  last = 0
  for tok in ids:
    last = forward(m, cache, w, bufs, pl, tok, pos)
    pos = pos + 1
  gen = 0
  while gen < n_gen:
    if last == m.eos:
      break
    fang_print_raw(unmap(m.vocab_str[last]))
    last = forward(m, cache, w, bufs, pl, last, pos)
    pos = pos + 1
    if temp > 0.0:
      last = sample_temp(bufs.logits, temp)
    else:
      last = sample_greedy(bufs.logits)
    gen = gen + 1
  print("")
  dt = time.now() - t0
  if dt > 0:
    print("generated", gen, "tokens in", dt, "s =", gen / dt, "tok/s")
